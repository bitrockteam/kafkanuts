# Radice dei dati persistiti sull'host.
# JetStream e PostgreSQL scrivono qui, non in un volume gestito da Docker:
# i dati restano visibili sul filesystem e sopravvivono anche a compose down -v.
# Puntala a un disco dedicato se serve, il resto della configurazione non cambia.
KAFKANUTS_DATA_DIR=./data

# Guardrail risorse locali (default sicuri; nessun segreto)
T02_BUILDER_CPUS=1.0
T02_BUILDER_MEMORY=1g
T02_TEST_CPUS=1.0
T02_TEST_MEMORY=1g
T02_NETWORK_NAME=kafkanuts-tooling
T02_MAVEN_CACHE_VOLUME=kafkanuts-maven-cache

# Stack NATS JetStream
T17_NETWORK_NAME=kafkanuts-nats
T17_NATS_CPUS=0.5
T17_NATS_MEMORY=512m

# Apicurio Registry e PostgreSQL
T17_REGISTRY_CPUS=1.0
T17_REGISTRY_MEMORY=1g
T17_POSTGRES_CPUS=0.5
T17_POSTGRES_MEMORY=512m
# Credenziali di laboratorio, non segrete e non riusabili fuori dalla demo
T17_POSTGRES_DB=apicurio
T17_POSTGRES_USER=apicurio
T17_POSTGRES_PASSWORD=apicurio

# Simulatori
T17_SIMULATOR_CPUS=0.5
T17_SIMULATOR_MEMORY=512m

# Console del flusso live: osserva JetStream con consumer effimeri e serve SSE
# alla dashboard. Non ha stato da persistere.
T20_CONSOLE_CPUS=0.5
T20_CONSOLE_MEMORY=512m

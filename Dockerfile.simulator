FROM maven:3.9-eclipse-temurin-26@sha256:b2c1ad85954592f9928e84327c65201f308ad9b5d8ed7d5b823717c97bf23fbb AS build
ARG MODULE
WORKDIR /workspace
COPY pom.xml .
COPY modules modules
COPY config config
RUN mvn -B -ntp -pl modules/${MODULE} -am -DskipTests package

FROM busybox:1.36.1-musl AS healthcheck

FROM eclipse-temurin:21.0.8_9-jre
ARG MODULE
COPY --from=build /workspace/modules/${MODULE}/target/${MODULE}-0.1.0-SNAPSHOT.jar /app/app.jar
COPY --from=healthcheck /bin/busybox /bin/busybox
WORKDIR /app
USER 10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
